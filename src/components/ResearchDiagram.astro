---
interface Props { id?: string }
const { id = 'research-map' } = Astro.props;
// Coordinates and edges define a non-directional network, not a workflow.
const nodes = [[178,115],[432,115],[185,350],[425,350],[228,55],[324,77],[410,48],[480,201],[450,282],[334,397],[143,258],[101,204],[305,157],[303,310]];
const edges = [[0,1],[0,2],[0,3],[1,2],[1,3],[2,3],[0,4],[0,5],[0,10],[0,11],[0,12],[1,5],[1,6],[1,7],[1,8],[1,12],[2,9],[2,10],[2,11],[2,13],[3,7],[3,8],[3,9],[3,13],[4,5],[5,6],[6,7],[7,8],[8,9],[9,10],[10,11],[11,4],[5,12],[10,12],[12,13],[8,13]];
---
<figure class="concept-diagram">
  <svg viewBox="0 0 610 450" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>Quantum Information: interconnected research perspectives</title>
    <desc id={`${id}-desc`}>Quantum Information is the central theme of a web connecting Measurements and Operations, Data and Information, Inference and Certification, and Computation and Optimization. Undirected connections represent mutual relationships, not a fixed sequence, independent disciplines, or a one-to-one mapping to the research highlights. Acquired measurement information can guide operations; existing information, inference, and analysis can also inform future measurements. These relationships include established examples and broader research perspectives, not a claim that every feedback mechanism has been demonstrated.</desc>
    <g stroke="#c4d4e5" stroke-width="1" opacity=".75">{edges.map(([a,b]) => <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]}/>)}</g>
    <circle cx="305" cy="230" r="94" fill="#eaf2fa" opacity=".65"/>
    <circle cx="305" cy="230" r="76" fill="#ddeaf7" opacity=".7"/>
    <circle cx="305" cy="230" r="59" fill="#cfE2f5" opacity=".65"/>
    <g fill="#d4e1ee">{nodes.slice(4).map(([x,y]) => <circle cx={x} cy={y} r="5.5"/>)}</g>
    <g stroke="#fff" stroke-width="2"><circle cx="178" cy="115" r="11" fill="#214b76"/><circle cx="432" cy="115" r="11" fill="#6f9ccc"/><circle cx="185" cy="350" r="11" fill="#6f9ccc"/><circle cx="425" cy="350" r="11" fill="#365e87"/></g>
    <g font-family="Arial, sans-serif" font-size="19" fill="#243c57">
      <text x="155" y="105" text-anchor="end"><tspan font-weight="600">Measurements</tspan><tspan x="155" dy="25" fill="#4d627a">&amp; Operations</tspan></text>
      <text x="455" y="105"><tspan font-weight="600">Data</tspan><tspan x="455" dy="25" fill="#4d627a">&amp; Information</tspan></text>
      <text x="162" y="344" text-anchor="end"><tspan font-weight="600">Inference</tspan><tspan x="162" dy="25" fill="#4d627a">&amp; Certification</tspan></text>
      <text x="448" y="344"><tspan font-weight="600">Computation</tspan><tspan x="448" dy="25" fill="#4d627a">&amp; Optimization</tspan></text>
    </g>
    <text x="305" y="224" text-anchor="middle" font-family="Georgia, serif" font-size="26" fill="#163d67">Quantum<tspan x="305" dy="31">Information</tspan></text>
  </svg>
</figure>
