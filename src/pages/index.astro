---
import Layout from '../layouts/Layout.astro';
import ResearchDiagram from '../components/ResearchDiagram.astro';
import Publication from '../components/Publication.astro';
import PersonPortrait from '../components/PersonPortrait.astro';
import { site } from '../data/site';
import { primaryPerson as person, personPublications, newestFirst, publicationDate, orderedHighlights as highlights } from '../data/academic';
import { href } from '../i18n/ui';
const recent = newestFirst(personPublications(person.id), publicationDate).slice(0,4);
---
<Layout title="Home">
  <section class="hero wrap">
    <div class="hero-copy"><h1>{person.name} <span lang="zh">{person.chineseName}</span></h1><p class="position">{person.position}</p><p class="affiliation">{person.affiliation.school}<span>{person.affiliation.institution}</span></p><div class="research-identity"><h2>{site.researchIdentity.title}</h2><p>{site.researchIdentity.subtitle}</p></div><p class="intro">{person.introduction}</p><div class="actions"><a class="button" href={href('research/')}>Explore my research <span aria-hidden="true">↗</span></a><a class="text-link" href={href('about/')}>About &amp; CV <span aria-hidden="true">→</span></a></div></div>
    <PersonPortrait person={person}/>
  </section>
  <section class="research-intro home-research section wrap"><div><h2>Research</h2><p>{site.researchSubtitle}</p><a class="text-link" href={href('research/')}>Explore my research →</a></div><ResearchDiagram/></section>
  <section class="section wrap"><div class="section-heading"><h2>Selected Research</h2><a class="text-link" href={href('research/#selected-research')}>View research →</a></div><div class="highlight-grid">{highlights.map(h => <article class="highlight-card"><span class="card-number">{String(h.order).padStart(2,'0')}</span><h3>{h.title}</h3><p>{h.summary}</p><a class="text-link" href={href(`research/#${h.id}`)}>Read more <span class="sr-only">about {h.title}</span>→</a></article>)}</div></section>
  <section class="section wrap"><div class="section-heading"><h2>Recent Publications</h2><a class="text-link" href={href('publications/')}>All publications →</a></div>{recent.map(p => <Publication paper={p} compact/>)}</section>
</Layout>
