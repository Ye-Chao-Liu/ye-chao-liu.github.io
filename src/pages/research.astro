---
import Layout from '../layouts/Layout.astro';
import ResearchDiagram from '../components/ResearchDiagram.astro';
import { orderedHighlights as highlights,highlightPublications } from '../data/academic';
import { site } from '../data/site';
import { href } from '../i18n/ui';
---
<Layout title="Research">
  <h1 class="sr-only">Research</h1>
  <section class="framework-diagram diagram-lead wrap" aria-label="Research framework diagram"><ResearchDiagram/></section>
  <div class="framework-explanation wrap"><p class="reading-width">{site.framework.full}</p></div>
  <section class="section wrap" id="selected-research"><h2>Selected Research</h2><nav class="research-index" aria-label="Research highlights">{highlights.map(h => <a href={`#${h.id}`}><span>{String(h.order).padStart(2,'0')}</span>{h.title}<span aria-hidden="true">↓</span></a>)}</nav>
  {highlights.map(h => <article class="research-highlight" id={h.id}><div class="research-number">{String(h.order).padStart(2,'0')}</div><div><h3>{h.title}</h3><p class="research-question">{h.summary}</p>{h.paragraphs.map(p => <p>{p}</p>)}<h4 class="small-heading">Representative publications</h4><ul class="related-papers">{highlightPublications(h.id).map(p => { return <li><a href={href(`publications/#${p.id}`)}>{p.title} <span aria-hidden="true">↗</span></a><span>{p.venue}</span></li>; })}</ul></div></article>)}
  </section>
</Layout>

<style>
  .framework-diagram.diagram-lead { padding-top: 20px; }
  .framework-explanation { padding-top: 12px; }
  .framework-explanation p { max-width: 760px; margin: 0 auto; font-size: 17px; line-height: 1.85; }
  @media (max-width: 700px) {
    .framework-diagram.diagram-lead { padding-top: 12px; }
    .framework-explanation { padding-top: 8px; }
    .framework-explanation p { font-size: 16px; }
  }
</style>
